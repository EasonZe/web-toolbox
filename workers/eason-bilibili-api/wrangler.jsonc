{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eason-bilibili-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bilibili-api.easonzhan.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
