{
  "name": "web-toolbox",
  "version": "1.1.0",
  "description": "多功能工具箱：面向浏览器的视频、音频、图片、文档、开发与生活工具集合。",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "EasonZe",
    "email": "qwas_qweasd@163.com",
    "url": "https://github.com/EasonZe"
  },
  "homepage": "https://tool.easonzhan.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasonZe/web-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/EasonZe/web-toolbox/issues"
  },
  "keywords": [
    "toolbox",
    "nextjs",
    "cloudflare-workers",
    "media-tools",
    "web-utilities"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-document-assets.mjs && vinext dev",
    "build": "node scripts/prepare-document-assets.mjs && vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern **/.wrangler/** --ignore-pattern public/soundtouch",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "bench:local": "node scripts/measure-local-performance.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
