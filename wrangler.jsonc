{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eason-video-toolbox-public",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tool.easonzhan.xyz/*",
      "zone_name": "easonzhan.xyz"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "VISITS_DB",
      "database_name": "eason-toolbox-stats",
      "database_id": "23c36811-3f36-426f-a20e-41a6f319ccc9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
